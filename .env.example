# Local configuration for demo (H2) and dev (MySQL).
# Copy to .env only if that file does not already exist. Never commit real secrets.
# Default: mvn spring-boot:run
# MySQL: mvn spring-boot:run "-Dspring-boot.run.profiles=dev"
# Copying this template is enough to start locally, NOT to send real email.
# Fill MAIL_USERNAME/MAIL_PASSWORD for OTP. demo ignores DB/JWT/VNPay/Cloudinary/Gemini.
# dev needs an existing MySQL database and a private JWT_SECRET.
# prod does not import .env: supply settings through system environment variables.
APP_BASE_URL=http://localhost:8080

# MySQL development database (create before startup)
DB_URL=jdbc:mysql://localhost:3306/beauty_store
DB_USERNAME=beautystore
DB_PASSWORD=

# Required for dev/prod: unique random secret of at least 32 bytes.
# Never reuse the public demo key or commit a real secret.
JWT_SECRET=

# Gmail SMTP: use your Gmail address and a Google App Password, not your login password.
# App Passwords require 2-Step Verification. Paste the 16 characters without spaces.
# Required for real OTP / transactional email in both demo and dev.
MAIL_USERNAME=
MAIL_PASSWORD=
# Optional verified sender alias; omit to use MAIL_USERNAME.
# MAIL_FROM=

# Optional AI; without a key, catalog/policy support remains available
GEMINI_API_KEY=

# Cloudinary (required for uploads outside demo)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=beautystore-products

# VNPay sandbox; leave credentials blank for COD-only development
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/payment/vnpay/return
VNPAY_IPN_URL=http://localhost:8080/api/payment/vnpay/ipn

# Required legal/contact details for prod (environment variables, not .env)
# Leave these commented locally to preserve the built-in fallback values.
# STORE_LEGAL_NAME=
# STORE_LEGAL_ADDRESS=
# STORE_SUPPORT_EMAIL=
