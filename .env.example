spring.profiles.active=dev
APP_BASE_URL=http://localhost:8080

# Database
DB_URL=jdbc:mysql://localhost:3306/beauty_store
DB_USERNAME=root
DB_PASSWORD=

# Authentication (use at least 32 random UTF-8 bytes)
JWT_SECRET=

# Email
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Gemini chatbot
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=beautystore-products

# VNPay sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/payment/vnpay/return
VNPAY_IPN_URL=http://localhost:8080/api/payment/vnpay/ipn
