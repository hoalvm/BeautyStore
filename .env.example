# Optional configuration for the explicitly selected dev profile.
# Default demo needs no credentials and does not load .env.
# Copy this file to .env, fill locally, then run:
# mvn spring-boot:run "-Dspring-boot.run.profiles=dev"
APP_BASE_URL=http://localhost:8080

# MySQL development database (create before startup)
DB_URL=jdbc:mysql://localhost:3306/beauty_store
DB_USERNAME=beautystore
DB_PASSWORD=

# Required for dev/prod: unique random secret of at least 32 bytes.
# Never reuse the public demo key or commit a real secret.
JWT_SECRET=

# SMTP (required for account activation/reset outside demo)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Optional AI; without a key, catalog/policy support remains available
GEMINI_API_KEY=

# Cloudinary (required for uploads outside demo)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=beautystore-products

# VNPay sandbox; leave credentials blank for COD-only development
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/payment/vnpay/return
VNPAY_IPN_URL=http://localhost:8080/api/payment/vnpay/ipn

# Required legal/contact details for prod (environment variables, not .env)
STORE_LEGAL_NAME=
STORE_LEGAL_ADDRESS=
STORE_SUPPORT_EMAIL=
